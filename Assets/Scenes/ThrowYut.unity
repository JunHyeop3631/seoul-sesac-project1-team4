  - unitKind: 0
    nameSprite: {fileID: 21300000, guid: cb3de019a6727504da4f9daa722ff55c, type: 3}
    idleLeft: {fileID: -1994879453731951147, guid: a1c1ebf7e6d53a543afaa83844bea3bd, type: 3}
    evolvedIdleLeft: {fileID: -8042066000336701108, guid: 5238a6f6e14894f4dbcaaf571c2f166a, type: 3}
    story: "\uC791\uC740 \uBD88\uC528\uB85C \uBC25\uC744 \uC9D3\uACE0\n\uBD80\uC801\uC73C\uB85C
      \uC561\uC6B4\uC744 \uCAD3\uB358 \uB3C4\uC0AC.\n\uBAA8\uB450\uC758 \uB530\uB73B\uD55C
      \uBC25\uC0C1\uC744 \uC9C0\uD0A8\uB2E4."
  - unitKind: 1
    nameSprite: {fileID: 21300000, guid: ffd046156bf829f4086c43c351889b6d, type: 3}
    idleLeft: {fileID: -2792271483819200986, guid: b63510b2365551f4daae592db46ccce9, type: 3}
    evolvedIdleLeft: {fileID: -3599001908375643525, guid: 8ab71ae7966d0834c853d85ad67faaaa, type: 3}
    story: "\uB9C8\uC9C0\uB9C9 \uC8FC\uBBFC\uC774 \uB3CC\uC544\uC62C \uB54C\uAE4C\uC9C0\n\uBB38\uC744
      \uB2EB\uC9C0 \uC54A\uB294 \uB9C8\uC744\uC758 \uBB38\uC9C0\uAE30.\n\uC624\uB298\uB3C4
      \uBAA8\uB450\uC758 \uADC0\uAC13\uAE38\uC744 \uC9C0\uD0A8\uB2E4."
  - unitKind: 2
    nameSprite: {fileID: 21300000, guid: 2ae7dc0caf396ec46aa49aea85026f49, type: 3}
    idleLeft: {fileID: -2201192588077051102, guid: 990eb79f7dfab884396055514e2d4fe7, type: 3}
    evolvedIdleLeft: {fileID: -7499398962888971351, guid: 333c5ce808b1e5b40afdcc5be455e8b2, type: 3}
    story: "\uAC81 \uB9CE\uC740 \uC591\uC774 \uCC3D\uC744 \uB4E4\uC5C8\uB2E4.\n\uB4A4\uC5D0
      \uC228\uC740 \uC544\uC774\uB4E4\uC744 \uC9C0\uD0A4\uB824\uACE0.\n\uC190\uC740
      \uB5A8\uB824\uB3C4 \uBB3C\uB7EC\uC11C\uC9C0 \uC54A\uB294\uB2E4."
  - unitKind: 3
    nameSprite: {fileID: 21300000, guid: ea73eb0ffb68eb64cb1b8ff86aa32a64, type: 3}
    idleLeft: {fileID: -4574223176437630170, guid: 2e72f11b8c8d206459c417ee4c7752d6, type: 3}
    evolvedIdleLeft: {fileID: -2450501662182767744, guid: 515a5dede667b8d4da61a28085854422, type: 3}
    story: "\uC1A5\uACFC \uB18D\uAE30\uAD6C\uB97C \uACE0\uCE58\uB358 \uB300\uC7A5\uC7A5\uC774.\n\uD3C9\uC0DD
      \uC77C\uAD70 \uB9C8\uC744\uC744 \uC9C0\uD0A4\uB824\uACE0\n\uAC00\uC7A5 \uBB34\uAC70\uC6B4
      \uCCA0\uD1F4\uB97C \uB4E4\uC5C8\uB2E4."
  - unitKind: 4
    nameSprite: {fileID: 21300000, guid: ba4ef22f09133f64cb71018f91cad5ad, type: 3}
    idleLeft: {fileID: -2744996306019965981, guid: cf2399be50e454541b56da41f4a3533d, type: 3}
    evolvedIdleLeft: {fileID: 101995776722299913, guid: 4e6a16580ec63a24cb1ebc04f6175ca9, type: 3}
    story: "\uD654\uC0B4\uC5D0 \uD3B8\uC9C0\uB97C \uBB36\uC5B4\uC11C\uB77C\uB3C4\n\uC57D\uC18D\uC744
      \uC9C0\uD0A4\uB358 \uB9C8\uC744\uC758 \uC804\uB839.\n\uC774\uC81C \uD3C9\uD654\uC758
      \uC18C\uC2DD\uC744 \uC804\uD558\uB824 \uD55C\uB2E4."
  - unitKind: 5
    nameSprite: {fileID: 21300000, guid: 1b087e1653a9efb4393e10b3485cc1ae, type: 3}
    idleLeft: {fileID: 21300000, guid: fed37ceeab9ec1c43a3fe4513391133d, type: 3}
    evolvedIdleLeft: {fileID: 21300000, guid: fed37ceeab9ec1c43a3fe4513391133d, type: 3}
    story: "\uB3C4\uAE68\uBE44\uB97C \uBD09\uC778\uD55C \uC804\uC124\uC758 \uC7A5\uAD70.\n\uC218\uD638\uC790\uB4E4\uC758
      \uAC04\uC808\uD55C \uBD80\uB984\uC5D0\n\uC7A0\uB4E4\uC5C8\uB358 \uCC3D\uC744
      \uB2E4\uC2DC \uB4E4\uC5B4 \uC62C\uB9B0\uB2E4."
